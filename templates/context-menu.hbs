<div>
    {{#if extras.length}}
        <div class="linemap-menu-extras">
            {{#each extras}}
                <a class="linemap-menu-extra" data-action="selectOption" data-option="{{key}}" data-tooltip="{{label}}" aria-label="{{localize label}}"><i class="fas {{icon}}" aria-hidden="true"></i></a>
            {{/each}}
        </div>
    {{/if}}
    {{#if menuOptions.left}}
        <a class="linemap-menu-item linemap-menu-item-left" data-action="selectOption" data-option="left" data-tooltip="{{menuOptions.left.label}}" aria-label="{{localize menuOptions.left.label}}"><i class="fas {{menuOptions.left.icon}}" aria-hidden="true"></i></a>
    {{/if}}
    {{#if menuOptions.right}}
        <a class="linemap-menu-item linemap-menu-item-right" data-action="selectOption" data-option="right" data-tooltip="{{menuOptions.right.label}}" aria-label="{{localize menuOptions.right.label}}"><i class="fas {{menuOptions.right.icon}}" aria-hidden="true"></i></a>
    {{/if}}
    {{#if below}}
        <div class="linemap-menu-below">
            {{#each sliders}}
                <label class="linemap-menu-slider linemap-menu-{{name}}" data-tooltip="{{label}}">
                    <i class="fas {{icon}}" aria-hidden="true"></i>
                    <input type="range" name="{{name}}" min="{{min}}" max="{{max}}" step="{{step}}" value="{{value}}" aria-label="{{localize label}}">
                </label>
            {{/each}}
            {{#if look}}
                <div class="linemap-menu-look" role="group" aria-label="{{localize look.label}}">
                    {{#each look.options}}
                        <a class="{{#if area}}area{{/if}} {{#if wide}}wide{{/if}} {{#if active}}active{{/if}}" data-action="selectLook" data-look="{{key}}" data-tooltip="{{label}}" aria-label="{{localize label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
                            {{#if image}}<img src="{{image}}" alt="" />{{else}}<span class="linemap-area-placeholder" style="height: {{lineWidth}}px"></span>{{/if}}
                        </a>
                    {{/each}}
                </div>
            {{/if}}
            {{#if colors}}
                <div class="linemap-menu-colors" role="group" aria-label="{{localize colors.label}}">
                    {{#each colors.options}}
                        <a class="linemap-menu-color linemap-menu-color-{{key}} {{#if active}}active{{/if}}" data-action="selectColor" data-color="{{key}}" data-tooltip="{{label}}" aria-label="{{localize label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#if color}}style="background-color: {{color}}"{{/if}}>{{#if icon}}<i class="fas {{icon}}" aria-hidden="true"></i>{{/if}}</a>
                    {{/each}}
                </div>
            {{/if}}
        </div>
    {{/if}}
</div>
