<section>
    <div class="form-group">
        <label>{{localize "linemap.ui.contentColor"}}</label>
        <div class="form-fields">
            <color-picker name="color" value="{{color}}"></color-picker>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "linemap.ui.symbolScale"}}</label>
        <div class="form-fields">
            <range-picker name="symbolScale" value="{{symbolScale}}" min="1" max="2" step="0.1"></range-picker>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "linemap.ui.halo"}}</label>
        <div class="form-fields">
            <input type="checkbox" name="halo" {{checked halo}}>
            <color-picker name="haloColor" value="{{haloColor}}"></color-picker>
        </div>
        <p class="hint">{{localize "linemap.ui.haloHint"}}</p>
    </div>
    <div class="form-group">
        <label>{{localize "linemap.ui.labelFont"}}</label>
        <div class="form-fields">
            <select name="labelFont">
                {{selectOptions labelFonts selected=labelFont}}
            </select>
        </div>
    </div>
</section>