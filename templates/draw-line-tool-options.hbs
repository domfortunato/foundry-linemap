<div id="linemap-tool-options">
    <div class="linemap-tool-shelf">
        {{#each styles as |style styleName|}}
            <a class="linemap-style-select {{#if (eq styleName ../activeStyle)}}active{{/if}}" data-action="set-line-style" data-line-style="{{styleName}}" aria-label="{{#if style.label}}{{localize style.label}}{{else}}{{styleName}}{{/if}}" data-tooltip="{{#if style.label}}{{style.label}}{{else}}{{styleName}}{{/if}}"><img src="{{style.icon}}" alt="" /></a>
        {{/each}}
    </div>
</div>
